# Copy to .env (git-ignored) and adjust. Read at build time by Gradle.

# Mock wardrobe: 21 real clothing photos (CC0 clothing-dataset + Wikimedia Commons,
# licenses in data/fixtures/modern-clothing/manifest.json). When true they are bundled
# into the APK and added to the wardrobe on first launch. Set false to disable.
FITCHECK_MOCK_WARDROBE=false

# Virtual Try-On backend. Empty = try-on is shown as unavailable (CORE mode).
# Local server: run `proxy/node_modules/.bin/vite-node proxy/scripts/tryon_local_server.ts`
# (config in ~/.fitcheckai_private/tryon.env; TRYON_OFFLINE_MOCK_OPENAI=true = free mock results,
# TRYON_LIVE_ENABLED=true + key = real generation). Emulator reaches the host at 10.0.2.2.
# Cleartext http is only allowed to 10.0.2.2/127.0.0.1 in debug builds.
FITCHECK_TRYON_URL=http://10.0.2.2:8788
# Must match TRYON_LOCAL_AUTH_TOKEN on the server if it sets one. Letters, digits, . _ - only.
FITCHECK_TRYON_TOKEN=
