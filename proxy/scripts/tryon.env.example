# Hướng dẫn 1 dòng: mkdir -p -m 700 ~/.fitcheckai_private && cp proxy/scripts/tryon.env.example ~/.fitcheckai_private/tryon.env && chmod 600 ~/.fitcheckai_private/tryon.env (sau đó điền giá trị thật vào tryon.env, KHÔNG ghi khóa vào repo).

# ==============================================================================
# 1. Chọn Provider & Công tắc LIVE tổng (Mặc định an toàn: LIVE tắt hoàn toàn)
# ==============================================================================
# Provider thử đồ chính: "fosta" (gpt-6-luna thử nghiệm) hoặc "openai" (gpt-image-2 chính thức) hoặc "fake"
TRYON_PROVIDER=fosta
# Cổng tổng cho phép gọi API trả phí thật (LUÔN giữ false; chỉ bật true khi đã cấu hình key & quota)
TRYON_LIVE_ENABLED=false

# ==============================================================================
# 2. Chế độ Offline Mock ($0.00 — dùng khi TRYON_LIVE_ENABLED=false)
# ==============================================================================
# Bật mock schema FOSTA cục bộ ("true" khi chạy mock với TRYON_PROVIDER=fosta)
TRYON_OFFLINE_MOCK_FOSTA=true
# Kịch bản giả lập cho mock FOSTA (mặc định "success")
TRYON_FOSTA_MOCK_SCENARIO=success
# Bật mock schema OpenAI cục bộ ("true" khi chạy mock với TRYON_PROVIDER=openai; giữ false khi dùng FOSTA)
TRYON_OFFLINE_MOCK_OPENAI=false
# Kịch bản giả lập cho mock OpenAI (mặc định "success")
TRYON_MOCK_SCENARIO=success

# ==============================================================================
# 3A. Cấu hình FOSTA Luna (Chỉ đọc ở backend local — KHÔNG đưa khóa vào repo/APK)
# ==============================================================================
# Khóa API FOSTA thật của bạn (để trống trong file mẫu; điền trong ~/.fitcheckai_private/tryon.env)
FOSTA_API_KEY=
# URL endpoint Responses API của FOSTA (mặc định https://codex.fosta.app/v1/responses)
FOSTA_ENDPOINT=https://codex.fosta.app/v1/responses
# Tên model FOSTA sử dụng để sinh ảnh thử đồ
FOSTA_MODEL=gpt-6-luna
# Thời gian chờ tối đa (ms) cho mỗi yêu cầu FOSTA (1000..300000 ms; mặc định 240000)
FOSTA_TIMEOUT_MS=240000
# Cổng xác nhận cho phép trừ quota FOSTA khi chạy LIVE (LUÔN giữ false trong file mẫu)
FOSTA_APPROVE_QUOTA=false

# ==============================================================================
# 3B. Cấu hình OpenAI Images Edit API (Chỉ dùng khi TRYON_PROVIDER=openai)
# ==============================================================================
# Khóa API OpenAI thật (để trống trong file mẫu; điền khi dùng provider "openai")
OPENAI_API_KEY=
# Base URL tùy chỉnh cho OpenAI API nếu dùng proxy nội bộ (để trống để dùng mặc định https://api.openai.com/v1)
OPENAI_API_BASE_URL=
# Tên model OpenAI Images API (mặc định gpt-image-2)
OPENAI_IMAGE_MODEL=gpt-image-2
# Kích thước ảnh đầu ra (mặc định 1024x1536)
OPENAI_IMAGE_SIZE=1024x1536
# Chất lượng ảnh đầu ra: low | medium | high | auto (mặc định medium)
OPENAI_IMAGE_QUALITY=medium
# Định dạng ảnh đầu ra: png | jpeg | webp (mặc định png)
OPENAI_OUTPUT_FORMAT=png
# Mức độ giữ nguyên chi tiết ảnh đầu vào: low | high | auto (mặc định auto)
OPENAI_INPUT_FIDELITY=auto
# OpenAI Organization ID tùy chọn (để trống nếu không cần)
OPENAI_ORG_ID=
# OpenAI Project ID tùy chọn (để trống nếu không cần)
OPENAI_PROJECT_ID=
# Thời gian chờ tối đa (ms) cho mỗi yêu cầu OpenAI (mặc định 90000)
OPENAI_TIMEOUT_MS=90000
# Cho phép dùng model OpenAI tùy chỉnh ngoài danh sách chuẩn (LUÔN giữ false trừ khi chủ đích thử model mới)
OPENAI_ALLOW_CUSTOM_MODEL=false

# ==============================================================================
# 4. Cổng An toàn Ngân sách, Hạn mức & Khả năng VTO
# ==============================================================================
# Xác nhận đã kiểm tra credit & cho phép chi ngân sách OpenAI LIVE (LUÔN giữ false trong file mẫu)
TRYON_BUDGET_CONFIRMED=false
# Cho phép chạy LIVE với model chưa có bảng giá ước tính tự động (LUÔN giữ false trong file mẫu)
TRYON_ALLOW_UNPRICED_MODEL=false
# Trần cứng tổng số lượt gọi LIVE tối đa lưu trong sổ cái bền vững (mặc định nhỏ = 1)
TRYON_LIVE_MAX_REQUESTS=1
# Trần chi phí ước tính tối đa (USD) cho các lượt LIVE OpenAI trước khi chặn BUDGET_EXCEEDED
TRYON_LIVE_MAX_ESTIMATED_USD=0.25
# Giới hạn số đơn vị ngân sách VTO theo phiên/cụm mặc định (mặc định 25)
VTO_BUDGET_CAP_UNITS=25
# Thời gian sống (ms) của ảnh kết quả tạm trên backend (để trống dùng mặc định 1800000 ms)
VTO_OUTPUT_TTL_MS=
# Trạng thái cổng khả thi trả về trong /v2/tryon/capabilities: GO_DUAL | GO_FRONT_ONLY | NO_GO | UNKNOWN
VTO_FEASIBILITY_DECISION=GO_DUAL
# Phiên bản cấu hình provider dùng để kiểm tra hiệu lực consent của người dùng
VTO_PROVIDER_CONFIG_VERSION=v2-fosta-poc-1
# Công tắc ngắt khẩn cấp toàn bộ tính năng thử đồ ("true" sẽ khóa cả mock lẫn live)
VTO_KILL_SWITCH=false

# ==============================================================================
# 5. Mạng Cục bộ, Lưu trữ Sổ cái & Xác thực Local Server
# ==============================================================================
# Địa chỉ bind của tryon_local_server.ts (chỉ cho phép loopback 127.0.0.1 / localhost / ::1)
TRYON_BIND_HOST=127.0.0.1
# Cổng lắng nghe của server VTO cục bộ (Emulator truy cập qua http://10.0.2.2:8788)
TRYON_PORT=8788
# Thư mục lưu sổ cái quota bền vững NGOÀI Git (để trống dùng mặc định ~/.fitcheckai_private/vto_server_state)
TRYON_STATE_DIR=
# Token tùy chọn gắn header x-tryon-local-token giữa app debug và 127.0.0.1:8788 (để trống khi chỉ bind 127.0.0.1)
TRYON_LOCAL_AUTH_TOKEN=
