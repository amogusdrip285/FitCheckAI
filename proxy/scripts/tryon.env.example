# FitCheckAI Track C — Local Try-On Configuration Template
# Copy OUTSIDE Git before adding real credentials:
#   mkdir -p -m 700 ~/.fitcheckai_private
#   cp proxy/scripts/tryon.env.example ~/.fitcheckai_private/tryon.env
#   chmod 600 ~/.fitcheckai_private/tryon.env

# 1. Provider Selector & Hard LIVE Gate (MUST stay false until explicit approval)
# Supported providers: "fosta" (experimental gpt-6-luna) | "openai" (official /v1/images/edits)
TRYON_PROVIDER=fosta
TRYON_LIVE_ENABLED=false

# Offline mock flags (set ONE matching TRYON_PROVIDER while TRYON_LIVE_ENABLED=false):
TRYON_OFFLINE_MOCK_FOSTA=true
TRYON_FOSTA_MOCK_SCENARIO=success
TRYON_OFFLINE_MOCK_OPENAI=false
TRYON_MOCK_SCENARIO=success

# 2A. Experimental FOSTA Luna Credentials & Config (Server-side ONLY — NEVER commit or put in APK)
FOSTA_API_KEY=
FOSTA_ENDPOINT=https://codex.fosta.app/v1/responses
FOSTA_MODEL=gpt-6-luna
FOSTA_TIMEOUT_MS=240000
FOSTA_APPROVE_QUOTA=false

# 2B. Official OpenAI Images Edit Credentials & Config (Preserved intact for TRYON_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_OUTPUT_FORMAT=png
OPENAI_INPUT_FIDELITY=auto
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# 3. Cost, Quota & Scope Guards (First Live Run: strictly 1 request cap)
TRYON_BUDGET_CONFIRMED=false
TRYON_LIVE_MAX_REQUESTS=1
TRYON_LIVE_MAX_ESTIMATED_USD=0.25
VTO_FEASIBILITY_DECISION=GO_DUAL
VTO_PROVIDER_CONFIG_VERSION=v2-fosta-poc-1
VTO_KILL_SWITCH=false
# Optional shared token between Android Emulator debug workbench and 127.0.0.1:8788 server:
TRYON_LOCAL_AUTH_TOKEN=
