# Copy thành proxy/.dev.vars (đã gitignore). KHÔNG commit file .dev.vars thật.

# Test miễn phí bằng Gemini free tier (key tạo ở Google AI Studio).
# Free tier: Google được dùng dữ liệu gửi lên để cải thiện sản phẩm ⇒ chỉ dùng ảnh/dữ liệu test.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Hoặc OpenAI-compatible (vd. gateway FOSTA cho demo GPT). FOSTA là bên thứ ba ⇒ chỉ dữ liệu test.
# AI_PROVIDER=openai
# AI_MODEL=gpt-6.1-sol
# OPENAI_BASE_URL=https://codex.fosta.app/v1
OPENAI_API_KEY=
# Ghi đè từng service (trống = dùng AI_PROVIDER/AI_MODEL chung), vd. outfits GPT + recognition Gemini:
# AI_PROVIDER_RECOGNITION=gemini
# AI_MODEL_RECOGNITION=

# Hoặc Anthropic (trả phí): AI_PROVIDER=anthropic và điền ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
DEMO_ACCESS_CODE=thay-bang-ma-demo
# Bật service khi chạy local (mặc định trong wrangler.toml là off):
SERVICE_RECOGNITION=on
SERVICE_OUTFITS=on
