<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:icon="@drawable/ic_vto_demo_launcher"
        android:roundIcon="@drawable/ic_vto_demo_launcher"
        android:label="FitCheck VTO Demo"
        android:networkSecurityConfig="@xml/tryon_debug_network_security_config">
        <activity
            android:name="com.fitcheckai.feature.tryon.demo.TryOnDemoActivity"
            android:exported="true"
            android:icon="@drawable/ic_vto_demo_launcher"
            android:label="FitCheck VTO Demo"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            tools:replace="android:exported,android:label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
